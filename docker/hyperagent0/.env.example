# Copy this file to .env (in the same directory as docker-compose.yml) and
# fill in the values you want. docker compose picks it up automatically.

# --- LLM provider ---------------------------------------------------------
# Default points at the local 9Router proxy described in CLAUDE.md.
# For direct providers, leave CHAT_MODEL_API_BASE empty and set the matching
# API key below.

CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_NAME=cc/claude-sonnet-4-6
# Leave blank to use the provider's default endpoint.
CHAT_MODEL_API_BASE=

# Provider API keys (only set the one(s) you actually use).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Host port ------------------------------------------------------------
# Map the container's :50080 to this port on the host. Pick something else
# if you already use 50080.
HYPERAGENT0_PORT=50080
