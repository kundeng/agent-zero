# Copy this file to .env (in the same directory as docker-compose.yml) and
# fill in the values you want. docker compose picks it up automatically.
#
# Anything you set here is applied to the container's settings.json on
# first start ONLY (when the field isn't already set), so restarts don't
# clobber values you later changed via the web UI.

# --- LLM provider ---------------------------------------------------------
# Leave these blank if you'd rather configure the LLM in the web UI's
# Settings panel — that's the recommended path for new installs.

CHAT_MODEL_PROVIDER=
CHAT_MODEL_NAME=
CHAT_MODEL_API_BASE=

# Provider API keys (only set the one(s) you actually use). These are
# read by upstream provider clients directly, not by the agent shell.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Host port ------------------------------------------------------------
# Map the container's :50080 to this port on the host. Pick something else
# if you already use 50080.
HYPERAGENT0_PORT=50080

# --- Code execution sandbox -----------------------------------------------
# Where the agent's generated code runs. Default (blank) keeps it in the
# agent's own container. Set to 'docker' or 'podman' to spawn one fresh
# sibling container per project — needs the docker socket volume in
# docker-compose.yml uncommented. See specs/05-project-isolation.
#
# Values: none | sandbox | ssh | cgroup | docker | podman
SANDBOX_MODE=
